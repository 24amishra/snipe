rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: authenticated
    function authed() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ─── Users ───────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if authed() && request.auth.uid == userId;
      allow update: if authed() && request.auth.uid == userId;
      allow delete: if false;
    }

    // ─── Game Results ────────────────────────────────────────────────
    match /gameResults/{docId} {
      allow read: if request.auth != null;
      allow create: if authed() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── Daily Questions (read-only for clients, admin writes) ───────
    match /dailyQuestions/{date} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── Question Bank (admin only) ─────────────────────────────────
    match /questionBank/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Groups ─────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if authed();
      allow update: if authed() && request.auth.uid in request.resource.data.memberIds;
      allow delete: if false;

      // Leaderboard subcollection
      match /leaderboard/{userId} {
        allow read: if request.auth != null;
        allow create: if authed();
        allow update: if authed() && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    // ─── Daily Stats (global averages) ──────────────────────────────
    match /dailyStats/{date} {
      allow read: if request.auth != null;
      allow write: if authed();
    }

    // ─── Logs (diagnostic, write-only for clients) ──────────────────
    match /logs/{docId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ─── Deny everything else ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
